<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the Microsoft Store package. build-store.ps1 fills in the $…$ values.
  IdentityName, Publisher and PublisherDisplayName come from Partner Center:
  your app → Product management → Product identity.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Focus with a glance</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ar-sa" />
  </Resources>

  <Applications>
    <Application Id="FocusGlance" Executable="Focus-with-a-glance.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Focus with a glance"
        Description="A liquid-glass notch with the time, prayer times, meetings, music and more."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="Focus-with-a-glance.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="FocusGlanceStartup" Enabled="true" DisplayName="Focus with a glance" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
